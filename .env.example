# ── BANCO (PostgreSQL na VPS OVH) ─────────────────
DATABASE_URL="postgresql://user:password@host:5432/academy?sslmode=require"

# ── NEXTAUTH ──────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="gerado-com-openssl-rand-base64-32"

# ── UPLOADS (Vercel Blob) ─────────────────────────
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ── CRON (crontab da VPS OVH chama /api/cron/* com ?secret=) ──
CRON_SECRET="hex-aleatorio"

# ── SUPORTE ───────────────────────────────────────
WHATSAPP_SUPPORT="5522999999999"

# ── SMTP (Brevo) ──────────────────────────────────
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="xxx@smtp-brevo.com"
SMTP_PASS="xsmtpsib-..."
SMTP_FROM_EMAIL="contato@exemplo.com.br"
SMTP_FROM_NAME="Valeriote Cursos e Consultoria"
SMTP_REPLY_TO="exemplo@gmail.com"

# ── ASAAS ─────────────────────────────────────────
ASAAS_ENV=sandbox
# aspas simples obrigatórias: a chave contém $ e não pode sofrer expansão
ASAAS_API_KEY='$aact_...'
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# produção: ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN="token-inventado-no-painel-do-asaas"
ASAAS_BILLING_TYPE=UNDEFINED
ASAAS_DUE_DAYS=3

# ── PONTE LP <-> ACADEMY (mesmo valor no .env da LP; header x-internal-token) ──
INTERNAL_API_TOKEN="hex-aleatorio-64"

# ── URLS ──────────────────────────────────────────
APP_URL=https://academy.valecursoseconsultoria.com.br
PAGE_URL=https://page.valecursoseconsultoria.com.br
