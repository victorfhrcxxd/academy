// Plataforma de transmissão ao vivo dos cursos presenciais Valeriote.
// Sem venda de cursos: o admin cadastra os alunos já inscritos e libera
// o acesso às lives de cada curso.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// role: ADMIN | MEMBER — status: ACTIVE | INACTIVE
// (strings em vez de enums por compatibilidade com SQLite)
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String // bcrypt hash
  role            String  @default("MEMBER")
  status          String  @default("ACTIVE")
  activeSessionId String? // sessão única: id da última sessão válida (alunos)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments  Enrollment[]
  chatMessages ChatMessage[]
  attendances   Attendance[]
  resetTokens   PasswordResetToken[]
  questions     Question[]
  questionVotes QuestionVote[]
  registrations Registration[]

  @@index([role])
  @@index([status])
}

// Token de recuperação de senha (link enviado por email, validade 1h)
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Curso presencial que terá transmissões ao vivo
model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("ACTIVE") // ACTIVE | ARCHIVED
  priceCents       Int? // preço da inscrição em centavos (nulo = inscrição indisponível)
  registrationOpen Boolean @default(false) // liga/desliga inscrições via LP/Asaas
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lives         Live[]
  enrollments   Enrollment[]
  registrations Registration[]

  @@index([status])
}

// Transmissão ao vivo de UM DIA do evento presencial (ex.: "Dia 1").
// embedUrl fica null até a plataforma de transmissão ser definida/configurada.
model Live {
  id           String    @id @default(cuid())
  courseId     String
  title        String // ex.: "Dia 1"
  description  String?
  scheduledAt  DateTime // início da transmissão do dia
  endsAt       DateTime? // término previsto
  embedUrl     String?
  replayUrl    String? // gravação (VOD) liberada depois que o dia encerra
  status       String    @default("SCHEDULED") // SCHEDULED | LIVE | ENDED
  chatLocked      Boolean @default(false) // chat bloqueado pela equipe
  chatSlowMode    Int     @default(0) // modo lento: segundos entre mensagens por aluno (0 = off)
  restrictPlayer  Boolean @default(false) // player protegido: oculta título/controles do YouTube e impede pausar
  pinnedMessageId String? // mensagem fixada no topo do chat
  peakViewers     Int     @default(0) // pico de espectadores simultâneos
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  talks       Talk[]
  messages    ChatMessage[]
  attendances Attendance[]
  questions   Question[]
  materials   Material[]

  @@index([courseId])
  @@index([status])
}

// Pergunta do Q&A de um dia (separada do chat)
model Question {
  id        String   @id @default(cuid())
  liveId    String
  userId    String
  text      String
  answered  Boolean  @default(false)
  createdAt DateTime @default(now())

  live  Live           @relation(fields: [liveId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes QuestionVote[]

  @@index([liveId])
}

model QuestionVote {
  id         String   @id @default(cuid())
  questionId String
  userId     String
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
}

// Template de email editável pelo admin (variáveis {{assim}})
model EmailTemplate {
  key       String   @id // lembrete | recuperar-senha
  subject   String
  body      String // HTML com variáveis
  updatedAt DateTime @updatedAt
}

// Controle de lembretes enviados (evita email duplicado)
model ReminderLog {
  id     String   @id @default(cuid())
  liveId String
  userId String
  kind   String // H24 | H1
  sentAt DateTime @default(now())

  @@unique([liveId, userId, kind])
}

// Avaliação do evento pelo aluno (1 a 5 estrelas + comentário)
model SurveyResponse {
  id        String   @id @default(cuid())
  courseId  String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([courseId, userId])
  @@index([courseId])
}

// Material de apoio de um dia (PDF/slide hospedado no Vercel Blob)
model Material {
  id        String   @id @default(cuid())
  liveId    String
  title     String
  url       String
  size      Int? // bytes
  createdAt DateTime @default(now())

  live Live @relation(fields: [liveId], references: [id], onDelete: Cascade)

  @@index([liveId])
}

// Presença: quanto tempo cada aluno assistiu à transmissão de um dia
model Attendance {
  id           String   @id @default(cuid())
  userId       String
  liveId       String
  watchSeconds Int      @default(0)
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  live Live @relation(fields: [liveId], references: [id], onDelete: Cascade)

  @@unique([userId, liveId])
  @@index([liveId])
}

// Palestra da programação de um dia do evento
model Talk {
  id           String    @id @default(cuid())
  liveId       String // dia do evento
  title        String // tema da palestra
  speakerName  String? // professor palestrante
  speakerPhoto String? // foto (data URL ou link https)
  startsAt     DateTime
  endsAt       DateTime?
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  live Live @relation(fields: [liveId], references: [id], onDelete: Cascade)

  @@index([liveId, startsAt])
}

// Mensagem do chat ao vivo de um dia do evento
model ChatMessage {
  id          String   @id @default(cuid())
  liveId      String
  userId      String
  text        String
  displayName String? // nome de exibição escolhido (só admins podem definir)
  createdAt   DateTime @default(now())

  live Live @relation(fields: [liveId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([liveId, createdAt])
}

// Vínculo aluno ↔ curso (matrícula manual do admin ou automática via Asaas)
model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  source    String   @default("MANUAL") // MANUAL (admin) | ASAAS (webhook de pagamento)
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

// Inscrição vinda da LP (presencial e online) — cobrada via Asaas.
// modality: PRESENCIAL | ONLINE
// status: PENDING | CONFIRMED | REFUNDED | CHARGEBACK | CANCELLED
model Registration {
  id              String    @id @default(cuid())
  courseId        String
  modality        String
  name            String
  email           String // identificador que amarra LP ↔ Asaas ↔ academy
  cpf             String
  phone           String?
  asaasCustomerId String?
  asaasPaymentId  String?   @unique // 1 cobrança = 1 inscrição
  status          String    @default("PENDING")
  paymentUrl      String? // invoiceUrl do Asaas devolvido pro lead
  userId          String? // nulo até o provisionamento (e sempre nulo no presencial)
  origin          Json? // UTM/rastreamento vindo da LP
  welcomeEmailAt  DateTime? // e-mail de confirmação/boas-vindas enviado
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  course Course @relation(fields: [courseId], references: [id])
  user   User?  @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([courseId, status])
}

// Evento de webhook do Asaas — id do próprio Asaas = chave da idempotência.
// processedAt nulo = pendente (o cron de varredura reprocessa)
model WebhookEvent {
  id          String    @id
  type        String // PAYMENT_CONFIRMED, PAYMENT_RECEIVED, ...
  paymentId   String?
  payload     Json // corpo bruto, para reprocessamento/auditoria
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([processedAt])
}
